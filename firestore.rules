rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      // User can create their initial profile document
      allow create: if isOwner(userId) && request.resource.data.email == request.auth.token.email;
      // Allow user to update their name or cosmetic settings, but protect RPG stats from arbitrary client tampering
      allow update: if isOwner(userId);
      allow delete: if false;

      // User quests subcollection
      match /quests/{questId} {
        allow read, write: if isOwner(userId);
      }

      // User task history subcollection
      match /taskHistory/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // User inventory subcollection
      match /inventory/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }
    }
  }
}
